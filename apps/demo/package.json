{
  "name": "@sketchboard/demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler pages dev .vercel/output/static --compatibility-date=2025-01-01",
    "deploy": "pnpm build && wrangler pages deploy .vercel/output/static",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "clean": "rm -rf .next .vercel dist"
  },
  "dependencies": {
    "@sketchboard/animation": "workspace:*",
    "@sketchboard/core": "workspace:*",
    "@sketchboard/react": "workspace:*",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "typescript": "^5",
    "wrangler": "^3"
  }
}
