{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@sketchboard/core": ["../../packages/core/src/index.ts"],
			"@sketchboard/core/*": ["../../packages/core/src/*"],
			"@sketchboard/react": ["../../packages/react/src/index.ts"],
			"@sketchboard/react/*": ["../../packages/react/src/*"],
			"@sketchboard/animation": ["../../packages/animation/src/index.ts"],
			"@sketchboard/animation/*": ["../../packages/animation/src/*"]
		},
		"types": [
			"./cloudflare-env.d.ts",
			"node"
		]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"../../packages/core/src/**/*.ts",
		"../../packages/react/src/**/*.ts"
	],
	"exclude": ["node_modules"]
}
